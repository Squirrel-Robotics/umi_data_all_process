# Copy the relevant values to each XR host without committing the populated file.
XR_MASTER_IP=CHANGE_ME
XR_SLAVE_IP=CHANGE_ME

# X2 slave: E6 capture and ROS bridge.
E6_SERIAL=CHANGE_ME
E6_ROSBRIDGE_URL=ws://CHANGE_ME:9090
E6_RIGHT_VIDEO_TOPIC=/teleoperation/master/video2/frame_image

# X2 slave: Revo2 identity and stable serial paths.
REVO2_LEFT_SERIAL=CHANGE_ME
REVO2_RIGHT_SERIAL=CHANGE_ME
REVO2_LEFT_PORT=/dev/serial/by-path/CHANGE_ME
REVO2_RIGHT_PORT=/dev/serial/by-path/CHANGE_ME
REVO2_GRIP_SOURCE_IP=CHANGE_ME

# XR master: UDP destination for the side-grip value.
REVO2_GRIP_DESTINATION=CHANGE_ME
REVO2_GRIP_PORT=39157
